PORT=4000
JWT_SECRET=replace-with-a-long-random-string-(openssl rand -hex 32)
JWT_EXPIRES_IN=8h
AI_SERVICE_URL=http://localhost:5001

# --- Supabase (PostgreSQL) ---------------------------------------------------------------
# Supabase dashboard -> your project -> "Connect" -> "Session pooler" -> copy the URI and paste it here.
# Replace [YOUR-PASSWORD] with your database password (Project Settings -> Database -> Reset password).
# If the password contains special characters (@ : / # ?), URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

LAB_NAME=Precision Calibration Laboratory
LAB_ADDRESS=
CERT_VALID_MONTHS=12
